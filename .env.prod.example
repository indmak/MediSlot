# 云端部署非密钥环境变量（可选）。复制为 .env.prod 使用。
#
# ⚠️ 数据库密码等敏感信息**不要**写在这里，改用 secrets/ 挂载文件（见 secrets/README.md）。
#    这里只放非敏感项；compose 中已给默认值，本文件留空也能启动。

# 数据库用户名（PostgreSQL，同时作为超级用户）
DB_USER=medislot

# 应用在宿主机回环上监听的端口（宝塔 Nginx 反代到它）
APP_PORT=8080

# 内置管理员账号覆盖（可选；默认 13000000000 / admin123）
# MEDISLOT_ADMIN_PHONE=13000000000
# MEDISLOT_ADMIN_PASSWORD=change_me
