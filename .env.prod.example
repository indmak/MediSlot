# 云端部署环境变量（复制为 .env.prod 并修改）
# 注意：.env.prod 已被 .gitignore 忽略，不要提交

# ---- 数据库 ----
DB_ROOT_PASSWORD=change_this_root_password
DB_USER=medislot
DB_PASSWORD=change_this_db_password

# ---- 应用端口（宿主机回环监听，宝塔 Nginx 反代到它） ----
APP_PORT=8080

# ---- 内置管理员账号（可覆盖默认 13000000000/admin123） ----
MEDISLOT_ADMIN_PHONE=13000000000
MEDISLOT_ADMIN_PASSWORD=admin123

# ---- 外部 API 密钥示例（按需添加；app 容器会通过 env_file 读取） ----
# 命名约定：MEDISLOT_EXTERNAL_<NAME>  →  Spring 属性 medislot.external.<name>
# MEDISLOT_EXTERNAL_SMS_APIKEY=your_sms_key
# MEDISLOT_EXTERNAL_WECHAT_APPSECRET=your_wechat_secret
